# This file is intentionally non-runnable. Copy it to ../.env.production and
# replace every placeholder through the deployment secret manager.
APP_ENV=production
HTTP_ADDR=:8080
DATABASE_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@REPLACE_DATABASE_HOST:5432/REPLACE_DATABASE?sslmode=verify-full
MEDIA_ROOT=/data/media
# Shared verified-delivery staging budget per API/worker process.
MEDIA_STAGE_MAX_BYTES=536870912
MEDIA_STAGE_MAX_OBJECTS=16
MEDIA_STAGE_MIN_FREE_BYTES=67108864
# Compose overrides this with /run/hcai-media-stage, bounded separately from exports.
MEDIA_STAGE_TEMP_DIR=
# Complete export budgets; never truncate records to satisfy these limits.
DATA_EXPORT_MAX_BYTES=536870912
DATA_EXPORT_MAX_ROW_BYTES=8388608
DATA_EXPORT_MIN_FREE_BYTES=67108864
# Existing private writable directory; empty uses the OS temporary directory.
# Compose overrides this with /run/hcai-exports and its bounded private mount.
DATA_EXPORT_TEMP_DIR=
MEDIA_STORAGE_ADAPTER=s3
MEDIA_S3_BUCKET=REPLACE_MEDIA_BUCKET
MEDIA_S3_REGION=REPLACE_MEDIA_REGION
MEDIA_S3_ENDPOINT=https://REPLACE_MEDIA_ENDPOINT
MEDIA_S3_ACCESS_KEY_ID=REPLACE_MEDIA_ACCESS_KEY_ID
MEDIA_S3_SECRET_ACCESS_KEY=REPLACE_MEDIA_SECRET_ACCESS_KEY
MEDIA_S3_SESSION_TOKEN=
MEDIA_S3_PATH_STYLE=false
MEDIA_S3_PREFIX=media
MEDIA_SCANNER_ADAPTER=http
MEDIA_SCANNER_URL=https://REPLACE_SCANNER_HOST/v1/scan
MEDIA_SCANNER_TOKEN=REPLACE_SCANNER_BEARER_TOKEN
MEDIA_SCANNER_TIMEOUT_SECONDS=30
WEB_ORIGIN=https://REPLACE_PUBLIC_ORIGIN
TRUSTED_PROXY_CIDRS=REPLACE_PROXY_CIDR
LOCAL_PROVIDER_ENABLED=false
COOKIE_SECURE=true
WEBHOOK_ENCRYPTION_KEY_B64=REPLACE_WEBHOOK_32_BYTE_BASE64_KEY
WEBHOOK_ALLOW_LOCAL=false
EMAIL_DELIVERY_MODE=disabled
EMAIL_ACTION_ENCRYPTION_KEY_B64=REPLACE_EMAIL_ACTION_32_BYTE_BASE64_KEY
# Set EMAIL_DELIVERY_MODE=smtp to enable real identity emails over implicit TLS.
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
STRIPE_ENABLED=false
STRIPE_LIVE_MODE=false
STRIPE_LIVE_MODE_APPROVED=false
# Waffo Pancake remains disabled until its rotated private key, connector,
# product, and public HTTPS webhook are provisioned by the deployment system.
PAYMENT_PROVIDER=stripe
WAFFO_ENABLED=false
WAFFO_ENVIRONMENT=test
WAFFO_PRODUCTION_APPROVED=false
WAFFO_MERCHANT_ID=REPLACE_WAFFO_MERCHANT_ID
WAFFO_STORE_ID=REPLACE_WAFFO_STORE_ID
WAFFO_CONNECTOR_URL=https://REPLACE_WAFFO_CONNECTOR_HOST
WAFFO_CONNECTOR_TOKEN=REPLACE_WAFFO_CONNECTOR_TOKEN
WAFFO_PRODUCT_ID_ONETIME=REPLACE_WAFFO_PRODUCT_ID_ONETIME
WAFFO_PRODUCT_ID_SUBSCRIPTION=
# Schema-reviewed read-only GraphQL query for product Checkout recovery.
# Keep empty until the merchant schema, authorization and end-to-end semantics are approved.
WAFFO_CHECKOUT_LOOKUP_QUERY=
OPENAI_ENABLED=false
OPENAI_PAID_CALLS_APPROVED=false
OPENAI_RECONCILIATION_ENABLED=false
OPENAI_RECONCILIATION_APPROVED=false
