# syntax=docker/dockerfile:1.7

FROM node:24-alpine AS build
WORKDIR /src
COPY web/package.json web/package-lock.json ./web/
RUN npm --prefix web ci --ignore-scripts
COPY web ./web
COPY internal/transport/httpapi/openapi.yaml ./internal/transport/httpapi/openapi.yaml
RUN npm --prefix web run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /src/web/dist /usr/share/nginx/html
RUN mkdir -p /var/cache/nginx /var/log/nginx /var/lib/nginx \
    && chown -R nginx:nginx /var/cache/nginx /var/log/nginx /var/lib/nginx /usr/share/nginx/html \
    && chmod -R a-w /usr/share/nginx/html
USER nginx
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
