{
  "name": "hcai-chat-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude 'e2e/**'",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --config playwright.ui.config.ts",
    "test:e2e:payments": "playwright test --config playwright.payments.config.ts",
    "generate:api": "openapi-typescript ../internal/transport/httpapi/openapi.yaml -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@github/markdown-toolbar-element": "2.2.3",
    "@vueuse/core": "^13.7.0",
    "dompurify": "^3.4.14",
    "lucide-vue-next": "^0.544.0",
    "marked": "^18.0.11",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/compiler-dom": "^3.5.41",
    "@vue/compiler-sfc": "^3.5.41",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^10.4.0",
    "openapi-typescript": "^7.9.1",
    "sass": "^1.102.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.6"
  }
}
